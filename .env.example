# --- Zetaris (local Docker install) ---
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=
# --- LLM provider: meterless (primary) | nvidia | openrouter (dev fallbacks only) ---
LLM_PROVIDER=meterless
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL_FAST=meterless/fast
METERLESS_MODEL_DEEP=meterless/deep
# dev fallback (build.nvidia.com free endpoint)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# dev fallback 2 (OpenRouter free Nemotron)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# --- agent ---
PSIG_MEMORY_DIR=.pricesignal/memory
# optional suffix for every Zetaris table/view the agent registers (a fresh suffix = a true cold start)
# PSIG_ZETARIS_NS=
PSIG_HTTP_USER_AGENT=PriceSignal/0.1 (Open Agent Hackathon 2026)
# optional tuning (defaults shown)
# PSIG_PORT=5177                 UI port
# PSIG_HEDGE_MS=10000            send the same model request again after this many ms without a reply
# PSIG_NO_THINK=1                1: Nemotron's hidden reasoning switched off; 0: on (slower)
# PSIG_CACHE_TTL_HOURS=6         refresh a cached source table after this many hours, only when the source answers
# PSIG_PRICE_LIST_URL=           your own price list (same JSON schema as data/price_list.json)
